//

// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project
    // #include? "Base-Release.xcconfig"

    // MARK: - Code signing & identity
    PRODUCT_BUNDLE_IDENTIFIER = Espineli-LLC.DripDrop
    PRODUCT_NAME = ThePoolApp
    DEVELOPMENT_TEAM = YOURTEAMID
    CODE_SIGN_STYLE = Automatic
    PROVISIONING_PROFILE_SPECIFIER =

    // MARK: - App display name (usually clean in prod)
    INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_NAME)

    // MARK: - Swift & compilation
    SWIFT_ACTIVE_COMPILATION_CONDITIONS = RELEASE PROD
    SWIFT_OPTIMIZATION_LEVEL = -O
    ENABLE_TESTABILITY = NO

    OTHER_SWIFT_FLAGS = $(inherited) -DRELEASE -DPROD
    GCC_PREPROCESSOR_DEFINITIONS = $(inherited) RELEASE=1 PROD=1

    // MARK: - API endpoints (example)
    API_BASE_URL = https://api.yourdomain.com
    WEBSOCKET_URL = wss://ws.yourdomain.com

    INFOPLIST_KEY_APIBaseURL = $(API_BASE_URL)

    // MARK: - App transport (tighten for prod)
    INFOPLIST_KEY_NSAppTransportSecurity = { NSAllowsArbitraryLoads = NO; }

    // MARK: - Feature flags (examples)
    FEATURE_NEW_ONBOARDING = YES
    FEATURE_EXPERIMENTAL_CACHE = NO
